{
	"name": "mariprogramming",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node scripts/sanitize-production-artifacts.mjs",
		"preview": "vite preview",
		"scan:artifacts": "node scripts/scan-production-artifacts.mjs",
		"verify:production": "npm run build && npm run scan:artifacts",
		"verify:release": "npm run lint && npm run check && npm test -- --coverage && npm run verify:production && npm run test:e2e && npm run test:e2e:live",
		"db:generate": "drizzle-kit generate --config=drizzle.config.js",
		"db:migrate": "drizzle-kit migrate --config=drizzle.config.js",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:live:support": "node --test tests/e2e/live/support/*.test.mjs",
		"test:e2e:live": "npm run test:e2e:live:support && node scripts/run-live-e2e.mjs",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^9.8.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/eslint": "9.6.0",
		"@types/node": "22.20.1",
		"@vitest/coverage-v8": "^3.2.7",
		"drizzle-kit": "0.31.10",
		"eslint": "^9.8.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^3.11.0",
		"globals": "^14.0.0",
		"jsdom": "^29.1.1",
		"pg": "^8.23.0",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.4",
		"vite": "^7.3.6",
		"vitest": "^3.2.7"
	},
	"type": "module",
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.6.27",
		"@neondatabase/serverless": "1.1.0",
		"better-auth": "1.6.27",
		"bufferutil": "4.1.0",
		"drizzle-orm": "0.45.2",
		"stripe": "^22.4.0",
		"ws": "8.21.3"
	}
}
