# Canonical application and Better Auth origins. Use HTTPS outside loopback development.
APP_ORIGIN=
BETTER_AUTH_URL=

# Runtime and migration roles use separate server-only Postgres credentials. Keep the migration
# credential in a controlled operator environment and do not add it to the Vercel application.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Generate independent secrets with at least 32 high-entropy characters. Do not reuse values.
BETTER_AUTH_SECRET=
RATE_LIMIT_HMAC_KEY=
BOOK_CHECKOUT_CAPABILITY_KEY=
# Vercel Cron sends this exact value as a Bearer credential. Rotate it independently.
CRON_SECRET=

# Server-only Google OAuth credentials for the approved staff identity.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only Stripe secrets for hosted card checkout and signed webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional lowercase ASCII hostname with at least three DNS labels. Leave blank unless Stripe
# Checkout uses an approved custom domain. This check validates syntax, not domain ownership.
STRIPE_CHECKOUT_HOST=

# Production stays closed until the documented legal, provider, database, and pickup approvals.
# Missing and invalid values also stay closed.
BOOK_DELIVERY_LAUNCH_STATE=coming-soon

# Required only when Book Delivery is live. Use exact lowercase hostnames separated by commas.
BOOK_DELIVERY_APPROVED_HOSTNAMES=

# Required only when Book Delivery is live. Set basis points only after tax approval.
BOOK_DELIVERY_TAX_RATE_BPS=

# Optional future e-Transfer recipient. Keep e-Transfer hidden until policy and verification are ready.
BOOK_DELIVERY_ETRANSFER_ADDRESS=

# Optional Discord incoming webhook for operational notices. Leave blank to skip delivery.
# Must be https://discord.com/api/webhooks/{id}/{token} when set. Never commit a live token.
DISCORD_WEBHOOK_URL=
POSTMARK_SERVER_TOKEN=
