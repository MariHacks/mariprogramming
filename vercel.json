{
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
				},
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=31536000"
				}
			]
		}
	],
	"crons": [
		{
			"path": "/api/cron/book-delivery",
			"schedule": "17 3 * * *"
		},
		{
			"path": "/api/cron/notify-relay",
			"schedule": "32 3 * * *"
		},
		{
			"path": "/api/cron/maritools-migrate",
			"schedule": "45 3 * * *"
		}
	]
}
